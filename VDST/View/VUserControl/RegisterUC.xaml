<UserControl
    x:Class="VDST.View.VUserControl.RegisterUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VDST.View.VUserControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:VDST.View.VUserControl"
    xmlns:vm="clr-namespace:VDST.ViewModel.UserControlVM"
    Name="root"
    d:DesignHeight="550"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <Border
        Margin="2,0,2,15"
        Background="White"
        BorderBrush="Gray"
        BorderThickness="0,1,0,0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" VerticalAlignment="Top">
                <Button
                    Margin="15"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Command="{Binding BackToLoginCommand}"
                    CommandParameter="{Binding ElementName=root}"
                    Style="{StaticResource btnIconLog}">
                    <Icons:PackIconMaterial
                        Width="25"
                        Height="25"
                        VerticalAlignment="Center"
                        Kind="ArrowLeft" />
                </Button>
                <TextBlock
                    Margin="15"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="25"
                    FontWeight="Bold"
                    Text="Register Account" />

            </Grid>

            <Grid Grid.Row="1">

                <StackPanel>
                    <StackPanel Margin="10" Orientation="Horizontal">
                        <Icons:PackIconMaterial
                            Width="20"
                            Height="20"
                            Kind="KeyAlertOutline" />
                        <TextBlock
                            Margin="5,0"
                            FontSize="15"
                            FontWeight="DemiBold"
                            Text="Computer Id" />
                    </StackPanel>

                    <Grid Margin="5,0">
                        <uc:CopyTextboxUC Foreground="Black" Text="{Binding ComputerId}" />
                    </Grid>
                    <TextBlock
                        Margin="10"
                        FontStyle="Italic"
                        FontWeight="Medium"
                        Text="Hãy sao chép mã và gửi cho Admin..."
                        TextWrapping="Wrap" />

                </StackPanel>


            </Grid>
        </Grid>
    </Border>
</UserControl>
