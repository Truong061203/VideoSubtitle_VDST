<UserControl
    x:Class="VDST.View.VUserControl.CopyTextboxUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VDST.View.VUserControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    d:DesignHeight="35"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <Border
        d:Background="White"
        BorderBrush="LightGray"
        BorderThickness="1"
        CornerRadius="7">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox
                    Padding="5,10"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="15"
                    FontWeight="DemiBold"
                    Foreground="Blue"
                    IsReadOnly="True"
                    Text="{Binding ElementName=root, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Grid Grid.Column="1" Margin="5">
                <Button
                    x:Name="BtnCopy"
                    Margin="0,0,10,0"
                    BorderThickness="0"
                    Click="Button_Click"
                    Style="{StaticResource btnIconLog}">
                    <Icons:PackIconMaterial
                        Width="20"
                        Height="20"
                        Kind="ContentCopy" />
                </Button>
            </Grid>
        </Grid>
    </Border>

</UserControl>
