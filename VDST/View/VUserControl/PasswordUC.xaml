<UserControl
    x:Class="VDST.View.VUserControl.PasswordUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VDST.View.VUserControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="passwordUserControl"
    d:DesignHeight="35"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  Eye Icon Path for Show Password  -->
        <Path
            x:Key="EyeIcon"
            Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"
            Fill="Gray"
            Stretch="Uniform"
            ToolTip="Ẩn" />

        <!--  Eye Slash Icon Path for Hide Password  -->
        <Path
            x:Key="EyeSlashIcon"
            Data="M11.83,9L15,12.16C15,12.11 15,12.05 15,12A3,3 0 0,0 12,9C11.94,9 11.89,9 11.83,9M7.53,9.8L9.08,11.35C9.03,11.56 9,11.77 9,12A3,3 0 0,0 12,15C12.22,15 12.44,14.97 12.65,14.92L14.2,16.47C13.53,16.8 12.79,17 12,17A5,5 0 0,1 7,12C7,11.21 7.2,10.47 7.53,9.8M2,4.27L4.28,6.55L4.73,7C3.08,8.3 1.78,10 1,12C2.73,16.39 7,19.5 12,19.5C13.55,19.5 15.03,19.2 16.38,18.66L16.81,19.09L19.73,22L21,20.73L3.27,3M12,7A5,5 0 0,1 17,12C17,12.64 16.87,13.26 16.64,13.82L19.57,16.75C21.07,15.5 22.27,13.86 23,12C21.27,7.61 17,4.5 12,4.5C10.6,4.5 9.26,4.75 8,5.2L10.17,7.35C10.76,7.13 11.37,7 12,7Z"
            Fill="Gray"
            Stretch="Uniform"
            ToolTip="Hiện" />
    </UserControl.Resources>

    <Border
        Width="300"
        Height="{Binding Height, ElementName=passwordUserControl}"
        MinHeight="30"
        Background="White"
        BorderBrush="Gray"
        BorderThickness="1"
        CornerRadius="7">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <!--  Password Box (Hidden)  -->
                <PasswordBox
                    x:Name="passwordBox"
                    Grid.Column="0"
                    Padding="8,0"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="14"
                    PasswordChanged="PasswordBox_PasswordChanged" />

                <!--  Text Box (Visible)  -->
                <TextBox
                    x:Name="textBox"
                    Grid.Column="0"
                    Height="35"
                    Padding="8,0"
                    VerticalContentAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="14"
                    FontWeight="Medium"
                    TextChanged="TextBox_TextChanged"
                    Visibility="Hidden" />

                <!--  Placeholder Text  -->
                <TextBlock
                    x:Name="placeholderText"
                    Grid.Column="0"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontStyle="Italic"
                    Foreground="LightGray"
                    IsHitTestVisible="False"
                    Text="{Binding Placeholder, ElementName=passwordUserControl}" />
            </Grid>

            <!--  Toggle Button  -->
            <Button
                x:Name="toggleButton"
                Grid.Column="1"
                Width="30"
                Height="30"
                Margin="0,0,5,0"
                Background="Transparent"
                BorderThickness="0"
                Click="ToggleButton_Click"
                Cursor="Hand">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <ContentPresenter
                    x:Name="iconPresenter"
                    Width="16"
                    Height="16"
                    Content="{StaticResource EyeSlashIcon}" />
            </Button>

        </Grid>
    </Border>
</UserControl>
