<UserControl
    x:Class="VDST.View.VUserControl.TextBoxUC"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VDST.View.VUserControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    d:DesignHeight="40"
    d:DesignWidth="400"
    FontFamily="Segoe UI"
    mc:Ignorable="d">
    <Grid d:Background="White">
        <TextBox
            x:Name="tbxWord"
            MinHeight="40"
            Padding="12,8"
            VerticalAlignment="Stretch"
            VerticalContentAlignment="Center"
            Background="White"
            FontWeight="Normal"
            Foreground="#111827"
            IsReadOnly="{Binding ElementName=root, Path=IsReadOnly, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Text="{Binding ElementName=root, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="7" />
                </Style>
            </TextBox.Resources>
        </TextBox>

        <TextBlock
            Margin="12,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            FontStyle="Italic"
            Foreground="Gray"
            IsHitTestVisible="False"
            Text="{Binding ElementName=root, Path=HintText, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=tbxWord}" Value="">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
