<Window
    x:Class="VDST.View.testView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VDST.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="testView"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <ListBox
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            ItemsSource="{Binding YoutubeModel.SubFilters}"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="5,10"
                        BorderBrush="#F0F0F0"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Margin="0,0,10,0"
                                Padding="5,2"
                                VerticalAlignment="Center"
                                Background="#EEE"
                                CornerRadius="3">
                                <TextBlock FontWeight="Bold" Foreground="#555" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="Gray"
                                    Text="{Binding Source}" />
                            </StackPanel>

                            <Grid Grid.Column="2">
                                <Button
                                    Padding="10,5"
                                    Command="{Binding DataContext.DownloadSingleSubCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Content="Tải" />

                                <ProgressBar
                                    Width="20"
                                    Height="20"
                                    IsIndeterminate="True" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
