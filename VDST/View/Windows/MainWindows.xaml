<Window
    x:Class="VDST.View.MainWindows"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VDST.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindows"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Border
            Background="#F5F7FA"
            BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="5"
                    Background="White"
                    CornerRadius="5">
                    <TextBlock
                        Margin="10"
                        HorizontalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="Dự án gần đây" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        Margin="0,0,0,30"
                        HorizontalAlignment="Center"
                        FontSize="24"
                        FontWeight="Bold"
                        Text="Bắt đầu công việc" />

                    <Button
                        Width="200"
                        Height="50"
                        Margin="0,10"
                        Background="#4F46E5"
                        Command="{Binding CreateNewProjectCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        FontSize="16"
                        Foreground="White">
                        + Tạo dự án mới
                    </Button>

                    <Button
                        Width="200"
                        Height="50"
                        Margin="0,10"
                        Background="White"
                        BorderBrush="#4F46E5"
                        Command="{Binding OpenProjectCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        FontSize="16">
                        Mở dự án có sẵn
                    </Button>
                </StackPanel>

                <Button
                    Width="30"
                    Height="30"
                    Margin="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding CloseCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Content="X" />
            </Grid>
        </Border>
    </Grid>
</Window>
