<Window
    x:Class="VDST.View.MainWindows"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VDST.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindows"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid >
        <Border Background="#F5F7FA" CornerRadius="10" BorderThickness="1" BorderBrush="Gray">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" Margin="5" CornerRadius="5">
                    <TextBlock Text="Dự án gần đây" HorizontalAlignment="Center" Margin="10" FontSize="16" FontWeight="Bold"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Bắt đầu công việc" FontSize="24" FontWeight="Bold" Margin="0,0,0,30" HorizontalAlignment="Center"/>

                    <Button Command="{Binding CreateNewProjectCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="200" Height="50" Margin="0,10" Background="#4F46E5" Foreground="White" FontSize="16">
                        + Tạo dự án mới
                    </Button>

                    <Button Command="{Binding OpenProjectCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Width="200" Height="50" Margin="0,10" Background="White" BorderBrush="#4F46E5" FontSize="16">
                        Mở dự án có sẵn
                    </Button>
                </StackPanel>

                <Button Content="X" 
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="30" 
                        Height="30" 
                    Command="{Binding CloseCommand}" 
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    Background="Transparent" BorderThickness="0" Margin="5"/>
            </Grid>
        </Border>
    </Grid>
</Window>
