<Window
    x:Class="VDST.View.Windows.UploadVideoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:VM="clr-namespace:VDST.ViewModel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VDST.View.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:VDST.View.VUserControl"
    x:Name="_this"
    Title="{Binding TitleApp, Mode=TwoWay}"
    Width="1280"
    Height="800"
    d:DataContext="{d:DesignInstance Type=VM:UpLoadVideoViewModel,
                                     IsDesignTimeCreatable=False}"
    Background="#f8fafc"
    FontFamily="Fonts\Inter_18pt-Regular.ttf"
    WindowState="Maximized"
    mc:Ignorable="d">
    <Window.DataContext>
        <VM:UpLoadVideoViewModel />
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="UploadBoxStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#333333" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle
                                x:Name="borderRect"
                                Fill="{TemplateBinding Background}"
                                RadiusX="20"
                                RadiusY="20"
                                Stroke="{TemplateBinding BorderBrush}"
                                StrokeDashArray="4 2"
                                StrokeThickness="2" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borderRect" Property="Stroke" Value="#5C5CFF" />
                                <Setter TargetName="borderRect" Property="Fill" Value="#F0F0FF" />
                                <Setter Property="Foreground" Value="#5C5CFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="borderRect" Property="Fill" Value="#E0E0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InnerButtonStyle" TargetType="Border">
            <Setter Property="Background" Value="#4A4AFF" />
            <Setter Property="CornerRadius" Value="15" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Background" Value="#3333CC" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Margin="30,10,0,0" Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <Image Height="50" Source="/Images/youtobe.png" />
                    <TextBlock
                        Margin="10,0"
                        VerticalAlignment="Center"
                        FontSize="30"
                        FontWeight="Bold"
                        Text="YouTube Lyric Extractor" />
                </StackPanel>

                <TextBlock
                    Margin="5,5,0,0"
                    FontSize="20"
                    FontWeight="Medium"
                    Foreground="Gray"
                    Text="Tải video và phụ đề từ đường dẫn YouTobe ." />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Border
                MinHeight="200"
                Margin="50,20,50,20"
                VerticalAlignment="Center"
                Background="White"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="20">
                <StackPanel
                    Margin="25"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <StackPanel Margin="25,0,0,10" Orientation="Horizontal">
                        <Icons:PackIconMaterial
                            Margin="0,5"
                            Foreground="blue"
                            Kind="LinkVariant" />
                        <TextBlock
                            Margin="10,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="DemiBold"
                            Text="Dán đường dẫn Video tại đây" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <uc:TextBoxUC
                            MinHeight="50"
                            Margin="20,0"
                            FontSize="18"
                            HintText="https://www.youtube.com/watch?v=..."
                            Text="{Binding YoutubeUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="1"
                            Width="200"
                            Command="{Binding CheckUrlCommand, Mode=OneWay}"
                            Style="{StaticResource BaseButtonLogin}">
                            <StackPanel Orientation="Horizontal">

                                <Icons:PackIconBootstrapIcons
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,10,0"
                                    Kind="Search" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    FontWeight="DemiBold"
                                    Text="Kiểm Tra" />
                            </StackPanel>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>
        </Grid>


        <Grid Grid.Row="2">
            <Grid>
                <Button
                    Margin="250,50,250,30"
                    AllowDrop="True"
                    Command="{Binding UploadCommand}"
                    Style="{StaticResource UploadBoxStyle}">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Viewbox
                            Width="100"
                            Height="100"
                            Margin="0,0,0,15"
                            HorizontalAlignment="Center">
                            <Path Data="M19.35,10.04C18.67,6.59 15.64,4 12,4C9.11,4 6.6,5.64 5.35,8.04C2.34,8.36 0,10.91 0,14C0,17.31 2.69,20 6,20H19C21.76,20 24,17.76 24,15C24,12.36 21.95,10.22 19.35,10.04M14,13V17H10V13H7L12,8L17,13H14Z" Fill="#9999FF" />
                        </Viewbox>

                        <TextBlock
                            Margin="0,0,0,5"
                            HorizontalAlignment="Center"
                            FontSize="27"
                            FontWeight="Bold"
                            Foreground="#333333"
                            Text="Xử lý Video Offline" />

                        <TextBlock
                            Margin="0,0,0,20"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Foreground="Gray"
                            Text="Kéo thả video vào đây hoặc click để chọn" />

                        <Border
                            Width="200"
                            Height="40"
                            Style="{StaticResource InnerButtonStyle}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="17"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Chọn File từ máy tính" />
                        </Border>
                    </StackPanel>
                </Button>
            </Grid>

        </Grid>
    </Grid>
</Window>
