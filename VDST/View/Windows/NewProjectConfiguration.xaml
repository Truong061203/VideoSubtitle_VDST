<Window
    x:Class="VDST.View.Windows.NewProjectConfiguration"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:Icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:NVM="clr-namespace:VDST.ViewModel"
    xmlns:UC="clr-namespace:VDST.View.VUserControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VDST.View.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="_this"
    Width="700"
    Height="720"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Fonts\Regular.ttf"
    MouseDown="Window_MouseDown"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.DataContext>
        <NVM:ProjectConfigViewModel/>
    </Window.DataContext>
    <Window.Resources>

        <Style x:Key="tblLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="DemiBold" />
        </Style>
    </Window.Resources>
    <Border
        Background="White"
        BorderThickness="2"
        CornerRadius="15">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0 0">
                <GradientStop Offset="0.2" Color="#1b1448" />
                <GradientStop Offset="1" Color="#DA34AE" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel
                    Margin="5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Margin="5"
                        Click="MiniSize_Click"
                        Style="{StaticResource btnIconLog}">
                        <Icons:PackIconMaterial
                            Width="15"
                            Height="15"
                            Kind="WindowMinimize" />
                    </Button>

                    <Button
                        Margin="5"
                        Click="Button_Close"
                        Style="{StaticResource btnIconLog}">
                        <Icons:PackIconMaterial
                            Width="15"
                            Height="15"
                            Kind="WindowClose" />
                    </Button>

                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="20">
                <StackPanel>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Icons:PackIconMaterial
                            Width="30"
                            Height="30"
                            Margin="0,3,15,0"
                            Foreground="#4338ca"
                            Kind="ListStatus" />
                        <TextBlock
                            FontSize="35"
                            FontWeight="Bold"
                            Foreground="#4338ca"
                            Text="Cấu Hình Tác Vụ " />
                    </StackPanel>
                    <TextBlock
                        Margin="10"
                        HorizontalAlignment="Center"
                        FontSize="20"
                        Foreground="Gray"
                        Text="Thiết lập các thông số cho dự án của bạn." />

                </StackPanel>

            </Grid>
            <Border
                Grid.Row="2"
                Margin="20,5,20,50"
                BorderBrush="LightGray"
                BorderThickness="0.5" />

            <Grid Grid.Row="3">
                <StackPanel Width="500" HorizontalAlignment="Center">
                    <TextBlock
                        Margin="10,0"
                        Style="{StaticResource tblLabel}"
                        Text="1. Tên dự án " />
                    <UC:TextBoxUC
                        Margin="10,3,0,20"
                        HintText="Nhập tên dự án ..."
                        Text="{Binding projectInfo.ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="10,0"
                        Style="{StaticResource tblLabel}"
                        Text="2. Thư mục lưu " />
                    <Grid>
                        <UC:TextBoxUC
                            Margin="10,3,0,20"
                            HintText="Đường dẫn lưu ..."
                            IsReadOnly="True"
                            Text="{Binding projectInfo.SaveLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Width="80"
                            Height="30"
                            Margin="0,3,5,20"
                            HorizontalAlignment="Right"
                            Command="{Binding ChooseCommand}"
                            CommandParameter="{Binding ElementName=_this}"
                            Style="{StaticResource btnChoose}">
                            <StackPanel Orientation="Horizontal">
                                <Icon:PackIconMaterial VerticalAlignment="Center" Kind="Folder" />
                                <TextBlock
                                    Margin="5,0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="Chọn" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBlock
                        Margin="10,0"
                        Style="{StaticResource tblLabel}"
                        Text="3. Ngôn ngữ gốc (Source) " />
                    <ComboBox
                        Height="35"
                        Margin="10,3,0,20"
                        Padding="10,9,0,0"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="#374151"
                        ItemsSource="{Binding SourceLanguages}"
                        SelectedItem="{Binding projectInfo.SourceLanguage}" />

                    <TextBlock
                        Margin="10,0"
                        Style="{StaticResource tblLabel}"
                        Text="4. Ngôn ngữ dịch (Target)" />

                    <ComboBox
                        Height="35"
                        Margin="10,3,0,15"
                        Padding="10,9,0,0"
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="#374151"
                        ItemsSource="{Binding TargetLanguages}"
                        SelectedItem="{Binding projectInfo.TargetLanguage}" />

                    <Button
                        Width="400"
                        Height="50"
                        Margin="30"
                        Command="{Binding OkCommand}"
                        CommandParameter="{Binding ElementName=_this}"
                        Style="{StaticResource BaseButtonLogin}">
                        <StackPanel Orientation="Horizontal">
                            <Icon:PackIconBootstrapIcons
                                Width="20"
                                Height="20"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center"
                                Kind="CheckCircle" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                FontSize="16"
                                FontWeight="DemiBold"
                                Text="Ok" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>
    </Border>
</Window>
