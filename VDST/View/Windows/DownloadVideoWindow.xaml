<Window
    x:Class="VDST.View.Windows.DownloadVideoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VDST.View.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:VDST.View.VUserControl"
    xmlns:vm="clr-namespace:VDST.ViewModel"
    Title="DownloadVideoWindow"
    Width="1280"
    Height="720"
    WindowState="Maximized"
    mc:Ignorable="d">
    <!--<Window.DataContext>
        <vm:DownloadVideoViewModel />
    </Window.DataContext>-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">

            <StackPanel
                Margin="25"
                VerticalAlignment="Top"
                Orientation="Vertical">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <uc:TextBoxUC
                        MinHeight="50"
                        Margin="20,0"
                        FontSize="18"
                        HintText="https://www.youtube.com/watch?v=..."
                        Text="{Binding Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Column="1"
                        Width="200"
                        MinHeight="50"
                        Command="{Binding CheckCommand, Mode=OneWay}"
                        Style="{StaticResource BaseButtonLogin}">
                        <StackPanel Orientation="Horizontal">

                            <Icons:PackIconBootstrapIcons
                                Width="20"
                                Height="20"
                                Margin="0,3,10,0"
                                VerticalAlignment="Center"
                                Kind="Search" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="22"
                                FontWeight="DemiBold"
                                Text="Kiểm Tra" />
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" />
    </Grid>
</Window>
