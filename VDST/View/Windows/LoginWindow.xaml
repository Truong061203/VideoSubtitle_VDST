<Window
    x:Class="VDST.View.Windows.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:LVM="clr-namespace:VDST.ViewModel"
    xmlns:VM="clr-namespace:VDST.ViewModel.UserControlVM"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:VDST.View.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:VDST.View.VUserControl"
    Name="_this"
    Width="500"
    Height="600"
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Fonts\Roboto-Black.ttf"
    Icon="/Images/login.png"
    MouseDown="Window_MouseDown"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.DataContext>
        <LVM:LoginMainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type VM:LogViewModelUC}">
            <uc:LoginUC />
        </DataTemplate>
        <DataTemplate DataType="{x:Type VM:RegisterViewModelUC}">
            <uc:RegisterUC />
        </DataTemplate>

    </Window.Resources>

    <Border
        Background="#f8fafc"
        BorderBrush="MediumSlateBlue"
        BorderThickness="2"
        CornerRadius="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock
                    Margin="15"
                    HorizontalAlignment="Left"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="Login-VDST" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Click="MiniSize_Click" Style="{StaticResource btnIconLog}">
                        <Icons:PackIconMaterial
                            Width="15"
                            Height="15"
                            Kind="WindowMinimize" />
                    </Button>

                    <Button Click="Button_Close" Style="{StaticResource btnIconLog}">
                        <Icons:PackIconMaterial
                            Width="15"
                            Height="15"
                            Kind="WindowClose" />
                    </Button>

                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <ContentControl Content="{Binding CurrentViewModel}" />
            </Grid>

            <Grid />
        </Grid>
    </Border>


</Window>
