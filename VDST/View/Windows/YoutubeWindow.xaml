<Window
    x:Class="VDST.View.Windows.YoutubeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:converters="clr-namespace:VDST.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:VDST.View.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:VDST.View.VUserControl"
    xmlns:vm="clr-namespace:VDST.ViewModel"
    x:Name="_this"
    Title="Youtube Extension"
    Width="1280"
    Height="720"
    d:DataContext="{d:DesignInstance Type=vm:YoutubeViewModel,
                                     IsDesignTimeCreatable=False}"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    mc:Ignorable="d">


    <Window.Resources>
        <converters:VfxConverters x:Key="BooleanVisibility" />
        <Style x:Key="RedBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="MinHeight" Value="35" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#B91C1C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>



    <Grid Background="#F1F5F9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <GridSplitter
            Grid.Column="1"
            Width="2"
            Margin="0,5"
            HorizontalAlignment="Stretch"
            Background="LightPink" />

        <!--  Column 1  -->
        <Grid Grid.Row="0" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="auto" />
                <RowDefinition />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <Image
                    Height="25"
                    Margin="0,5,0,0"
                    Source="/Images/youtobe.png" />
                <TextBlock
                    Margin="10,0"
                    VerticalAlignment="Center"
                    FontSize="25"
                    FontWeight="Bold"
                    Text="YouTube Extractor" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,20,0,0">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <Icons:PackIconMaterial
                            Margin="5,0,0,0"
                            Foreground="blue"
                            Kind="LinkVariant" />
                        <TextBlock
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="DemiBold"
                            Text="Dán đường dẫn Video tại đây" />
                    </StackPanel>

                    <Grid>
                        <uc:TextBoxUC
                            MinHeight="45"
                            Margin="0,5"
                            FontSize="15"
                            HintText="https://www.youtube.com/watch?v=..."
                            KeyDown="TextBoxUC_KeyDown_1"
                            Text="{Binding InputUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Margin="0,0,5,0"
                            HorizontalAlignment="Right"
                            Command="{Binding CheckCommand}"
                            CommandParameter="{Binding ElementName=_this}"
                            Style="{StaticResource RedBtnStyle}">
                            <Icons:PackIconBootstrapIcons
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Kind="Search" />
                        </Button>

                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="0,15,0,0">
                <Grid
                    Margin="0"
                    Panel.ZIndex="1"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanVisibility}}">
                    <ProgressBar
                        Margin="0"
                        IsIndeterminate="True"
                        Style="{StaticResource CircleStyle}" />
                </Grid>

                <Border
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="10">
                    <Image Source="{Binding youtubeModel.Thumbnail, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" Stretch="Fill" />
                </Border>

                <Border Background="#80000000" Opacity="0.3" />
            </Grid>
            <TextBlock
                Grid.Row="3"
                Margin="0,10"
                FontSize="18"
                FontWeight="DemiBold"
                Text="{Binding youtubeModel.Title, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                TextWrapping="WrapWithOverflow" />

            <Grid Grid.Row="4">
                <Button Margin="20,0,20,10" Command="{Binding DownloadVideoCommand}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="MinHeight" Value="50" />
                            <Setter Property="MinWidth" Value="50" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Background" Value="#0F172A" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1E293B" />
                                </Trigger>

                                <!--  2. Pressed (Nhấn): Đen tuyền (#000000) hoặc Xanh đậm  -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Background" Value="#000000" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                    <StackPanel Orientation="Horizontal">
                        <Icons:PackIconMaterial
                            Width="20"
                            Height="20"
                            Margin="10,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="Video" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="18"
                            Text="Tải Video (MP4)" />
                    </StackPanel>
                </Button>
            </Grid>

        </Grid>


        <!--  Column 2  -->
        <Grid Grid.Column="2" Margin="0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border BorderBrush="LightGray" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="AUTO" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="10,5"
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Text="Danh Sách Phụ Đề "
                        TextWrapping="Wrap" />
                    <Grid Grid.Column="1" Margin="0,5,10,0">
                        <uc:TextBoxUC
                            x:Name="txtLink"
                            MinHeight="40"
                            Margin="0,5"
                            FontSize="15"
                            HintText="Nhập ngôn ngữ để tìm kiếm  ..."
                            KeyDown="TextBoxUC_KeyDown"
                            Text="{Binding SearchSubText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Grid>
            </Border>


            <ListBox
                Grid.Row="1"
                Margin="10"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding youtubeModel.SubFilters}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Padding" Value="0" />

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border
                                        x:Name="border"
                                        Padding="{TemplateBinding Padding}"
                                        Background="#FAFAFA"
                                        BorderBrush="#E5E7EB"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="true">
                                        <ContentPresenter />
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="White" />
                                            <Setter TargetName="border" Property="BorderBrush" Value="Black" />
                                        </Trigger>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="Azure" />
                                            <Setter TargetName="border" Property="BorderBrush" Value="Black" />
                                            <Setter TargetName="border" Property="BorderThickness" Value="1" />
                                        </Trigger>


                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="50" Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Width="40"
                                Height="32"
                                Margin="0,0,15,0"
                                VerticalAlignment="Center"
                                Background="#E2E8F0"
                                CornerRadius="6">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="Bold"
                                    Foreground="#475569"
                                    Text="{Binding Language}" />
                            </Border>

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#1E293B"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />

                            <Button
                                Grid.Column="2"
                                Margin="8"
                                Command="{Binding DataContext.DownloadSubtitleFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                Content="Tải xuống"
                                Cursor="Hand"
                                FontSize="13"
                                FontWeight="Medium">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <!--  Trạng thái bình thường  -->
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="Foreground" Value="Black" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="BorderBrush" Value="#0F172A" />
                                        <Setter Property="Width" Value="100" />

                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        SnapsToDevicePixels="true">
                                                        <!--  Quan trọng: truyền Foreground xuống nội dung  -->
                                                        <ContentPresenter
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            TextElement.Foreground="{TemplateBinding Foreground}" />
                                                    </Border>

                                                    <ControlTemplate.Triggers>
                                                        <!--  Hover  -->
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#D32F2F" />
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="BorderBrush" Value="#D32F2F" />
                                                        </Trigger>

                                                        <!--  Pressed  -->
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#B71C1C" />
                                                            <Setter Property="Foreground" Value="White" />
                                                        </Trigger>

                                                        <!--  Disabled  -->
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.6" />
                                                            <Setter Property="Background" Value="#F5F5F5" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>



    </Grid>
</Window>
